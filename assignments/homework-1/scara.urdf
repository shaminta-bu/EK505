<?xml version="1.0"?>
<robot name="scara_robot">

  <!-- ======================================================================= -->
  <!-- MATERIALS                                                               -->
  <!-- ======================================================================= -->
  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 1.0 0.0 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>

  <!-- ======================================================================= -->
  <!-- LINKS                                                                   -->
  <!-- ======================================================================= -->

  <!-- Red Cylindrical Base, much heavier than the rest of the robot -->
  <link name="base_link">
    <visual>
      <!-- Offset center up so the base sits on the ground floor -->
      <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.15" length="0.3"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.15" length="0.3"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
      <mass value="20.0"/>
      <!-- Solid cylinder inertia calculations -->
      <inertia ixx="0.2625" ixy="0.0" ixz="0.0" iyy="0.2625" iyz="0.0" izz="0.225"/>
    </inertial>
  </link>

  <!-- Green First Arm Link, 1 m along x -->
  <link name="link1">
    <visual>
      <!-- Shift visual origin so the link extends from the joint at x=0 to x=1 -->
      <origin xyz="0.5 0.0 0.04" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="1.0 0.08 0.08"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0.5 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="1.0 0.08 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.5 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="1.0"/>
      <!-- Long box inertia calculations -->
      <inertia ixx="0.001067" ixy="0.0" ixz="0.0" iyy="0.083867" iyz="0.0" izz="0.083867"/>
    </inertial>
  </link>

  <!-- Blue Second Arm Link, 1 m along x -->
  <link name="link2">
    <visual>
      <!-- Shift visual origin so the link extends from the joint at x=0 to x=1 -->
      <origin xyz="0.5 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="1.0 0.08 0.08"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.5 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="1.0 0.08 0.08"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.5 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="1.0"/>
      <!-- Long box inertia calculations -->
      <inertia ixx="0.001067" ixy="0.0" ixz="0.0" iyy="0.083867" iyz="0.0" izz="0.083867"/>
    </inertial>
  </link>

  <!-- Red Plunger, slides vertically at the end of link2 -->
  <link name="plunger">
    <visual>
      <!-- Hang the rod below the joint origin so it points toward the ground -->
      <origin xyz="0.0 0.0 -0.23" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.025" length="0.44"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 -0.23" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.025" length="0.44"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 -0.23" rpy="0.0 0.0 0.0"/>
      <mass value="0.25"/>
      <!-- Solid cylinder inertia calculations -->
      <inertia ixx="0.004447" ixy="0.0" ixz="0.0" iyy="0.004447" iyz="0.0" izz="0.000078"/>
    </inertial>
  </link>

  <!-- Red End Effector marker at the tip of the plunger -->
  <link name="ee_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.05"/>
      <!-- Solid sphere inertia calculations -->
      <inertia ixx="0.000008" ixy="0.0" ixz="0.0" iyy="0.000008" iyz="0.0" izz="0.000008"/>
    </inertial>
  </link>

  <!-- ======================================================================= -->
  <!-- JOINTS                                                                  -->
  <!-- ======================================================================= -->

  <!-- First Joint (Z-Axis, revolute, on top of the base) -->
  <joint name="base_to_link1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <!-- Positioned at the top surface of the base cylinder -->
    <origin xyz="0.0 0.0 0.3" rpy="0.0 0.0 0.0"/>
    <axis xyz="0.0 0.0 1.0"/>
    <limit lower="-3.1416" upper="3.1416" effort="50.0" velocity="2.0"/>
  </joint>

  <!-- Second Joint (Z-Axis, revolute, at the end of link1) -->
  <joint name="link1_to_link2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <!-- Positioned at the far end of link1 -->
    <origin xyz="0.92 0.0 0.08" rpy="0.0 0.0 0.0"/>
    <axis xyz="0.0 0.0 1.0"/>
    <!-- Limited to +-2.5 rad (~143 deg) so the plunger cannot swing back and
         collide with link1 or the base (full fold-back would occur at +-pi) -->
    <limit lower="-2.5" upper="2.5" effort="50.0" velocity="2.0"/>
  </joint>

  <!-- Third Joint (Z-Axis, prismatic, at the end of link2) -->
  <joint name="link2_to_plunger" type="prismatic">
    <parent link="link2"/>
    <child link="plunger"/>
    <!-- Positioned at the far end of link2 -->
    <origin xyz="1.025 0.0 0.08" rpy="0.0 0.0 0.0"/>
    <!-- Downward axis: positive joint value extends the plunger toward the ground -->
    <axis xyz="0.0 0.0 -1.0"/>
    <limit lower="-0.25" upper="0.0" effort="50.0" velocity="0.5"/>
  </joint>

  <!-- Fourth Joint (Fixed, at the tip of the plunger) -->
  <joint name="plunger_to_ee" type="fixed">
    <parent link="plunger"/>
    <child link="ee_link"/>
    <origin xyz="0.0 0.0 -0.46" rpy="0.0 0.0 0.0"/>
  </joint>

</robot>
