<?xml version="1.0"?>
<robot name="cartpole_robot">

  <!-- ======================================================================= -->
  <!-- MATERIALS                                                               -->
  <!-- ======================================================================= -->
  <material name="red">
    <color rgba="1.0 0.0 0.0 1.0"/>
  </material>

  <material name="green">
    <color rgba="0.0 1.0 0.0 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.0 0.0 1.0 1.0"/>
  </material>

  <!-- ======================================================================= -->
  <!-- LINKS                                                                   -->
  <!-- ======================================================================= -->

  <!-- Red Rail Base, much heavier than the rest, sits on the ground plane -->
  <link name="base_link">
    <visual>
      <!-- Offset center up so the base sits on the ground floor -->
      <origin xyz="0.0 0.0 0.075" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="4.0 0.3 0.15"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.075" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="4.0 0.3 0.15"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.075" rpy="0.0 0.0 0.0"/>
      <mass value="20.0"/>
      <!-- Solid box inertia calculations -->
      <inertia ixx="0.1875" ixy="0.0" ixz="0.0" iyy="26.70417" iyz="0.0" izz="26.81667"/>
    </inertial>
  </link>

  <!-- Green Cart, slides along the rail -->
  <link name="cart">
    <visual>
      <!-- Offset center up so the cart sits on top of the rail -->
      <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.3 0.5 0.2"/>
      </geometry>
      <material name="green"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
      <geometry>
        <box size="0.3 0.5 0.2"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.1" rpy="0.0 0.0 0.0"/>
      <mass value="1.0"/>
      <!-- Solid box inertia calculations -->
      <inertia ixx="0.024167" ixy="0.0" ixz="0.0" iyy="0.010833" iyz="0.0" izz="0.028333"/>
    </inertial>
  </link>

  <!-- Blue Pole, swings freely about the cart -->
  <link name="pole">
    <visual>
      <!-- Offset cylinder visual center by half its length so it extends upward from the joint -->
      <origin xyz="0.0 0.0 0.5" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.02" length="1.0"/>
      </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.5" rpy="0.0 0.0 0.0"/>
      <geometry>
        <cylinder radius="0.02" length="1.0"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.5" rpy="0.0 0.0 0.0"/>
      <mass value="0.15"/>
      <!-- Solid cylinder inertia calculations -->
      <inertia ixx="0.012515" ixy="0.0" ixz="0.0" iyy="0.012515" iyz="0.0" izz="0.00003"/>
    </inertial>
  </link>

  <!-- Red End Effector marker at the tip of the pole -->
  <link name="ee_link">
    <visual>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
      <material name="red"/>
    </visual>
    <collision>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <geometry>
        <sphere radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
      <mass value="0.05"/>
      <!-- Solid sphere inertia calculations -->
      <inertia ixx="0.000018" ixy="0.0" ixz="0.0" iyy="0.000018" iyz="0.0" izz="0.000018"/>
    </inertial>
  </link>

  <!-- ======================================================================= -->
  <!-- JOINTS                                                                  -->
  <!-- ======================================================================= -->

  <!-- First Joint (X-Axis, prismatic, cart sliding on top of the rail) -->
  <joint name="base_to_cart" type="prismatic">
    <parent link="base_link"/>
    <child link="cart"/>
    <!-- Positioned at the top surface of the base rail -->
    <origin xyz="0.0 0.0 0.15" rpy="0.0 0.0 0.0"/>
    <axis xyz="1.0 0.0 0.0"/>
    <!-- Rail is 4 m long (half-length 2 m); keeps the 0.3 m-wide cart from leaving the base -->
    <limit lower="-1.8" upper="1.8" effort="50.0" velocity="1.0"/>
  </joint>

  <!-- Second Joint (Y-Axis, revolute, pole swinging on top of the cart) -->
  <!-- Changed from continuous to revolute and given explicit position limits -->
  <!-- so the viewer exposes a joint slider and the pole visibly swings about Y. -->
  <joint name="cart_to_pole" type="revolute">
    <parent link="cart"/>
    <child link="pole"/>
    <!-- Positioned at the top surface of the cart -->
    <origin xyz="0.0 0.28 0.1" rpy="0.0 0.0 0.0"/>
    <axis xyz="0.0 1.0 0.0"/>
    <!-- +/- pi range: a full swing about the Y axis -->
    <limit lower="-3.14159" upper="3.14159" effort="20.0" velocity="5.0"/>
  </joint>

  <!-- Third Joint (Fixed, at the tip of the pole) -->
  <joint name="pole_to_ee" type="fixed">
    <parent link="pole"/>
    <child link="ee_link"/>
    <origin xyz="0.0 0.0 1.0" rpy="0.0 0.0 0.0"/>
  </joint>

</robot>
